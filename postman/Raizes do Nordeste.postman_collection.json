                  "pm.test(\"Login deve retornar 200\", function() {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response deve conter accessToken\", function() {\r",
                  "    const resposta = pm.response.json();\r",
                  "    pm.expect(resposta.accessToken).to.not.be.undefined;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Perfil deve ser CLIENTE\", function() {\r",
                  "    const resposta = pm.response.json();\r",
                  "    pm.expect(resposta.user.perfil).to.equal(\"CLIENTE\");\r",
